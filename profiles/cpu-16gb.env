# x86/ARM machine with ~16 GB RAM and no usable GPU. This tier is tight: 32 GB is the practical floor for agent work.
# Nothing vetted fits here with the usual 3 GiB left for the OS and OpenCode. The smallest vetted uncensored
# Qwen3.6 file (MTP-Preserved i1-Q2_K) is 12.0 GiB resident and 2-bit, so this tier runs gpt-oss-20b instead
# (MoE, 3.6B active, native MXFP4, so no extra quantization loss).
# Budget (MemTotal ~15.3 GiB), one llama-server process for every role:
#   gpt-oss-20b heretic-ara-v3 11.3 GiB + KV 32K 0.75 GiB (24 KiB/token) + SWA checkpoints ~0.1
#   + ~1.5 GiB compute (assumed, not measured) + no prompt cache = ~13.6 GiB, ~1.7 GiB left.
#   That is ~1.3 GiB under the 3 GiB floor. Weights are mmap'd, so overshoot evicts cold expert pages and
#   re-reads them from disk (slower decode) rather than OOM-killing. Run headless and close the browser.
#   Check the real "CPU compute buffer size" in `ula logs`; if it is well under 1.5 GiB the margin is better.
# coder and architect name the same file and context, so ula runs them as one process: switching between
# plan and build agents keeps the KV cache. 32K is the least OpenCode can work in; expect early compaction.
# gpt-oss caveats: "<alias>:fast" only lowers reasoning_effort to low (harmony has no thinking-off switch),
# and its template silently drops a system message that is not the first one.
# embed/rerank are listed but not installed by default: together they need another ~2.7 GiB.
PROFILE_DESC="CPU only, ~16 GB RAM (tight; 32 GB recommended)"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=gpt-oss-20b-heretic-ara-mxfp4@32768
architect=gpt-oss-20b-heretic-ara-mxfp4@32768
coder-stock=gpt-oss-20b-mxfp4@32768
architect-stock=gpt-oss-20b-mxfp4@32768
embed=qwen3-embedding-0.6b-q8@4096
rerank=qwen3-reranker-0.6b-q8@4096
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=true          # coder and architect are one process; true keeps uncensored and stock from loading together
ULA_GPU_ARGS=""             # CPU. A Vulkan/ROCm build still offloads to an iGPU by default (-ngl auto); ULA_ACCEL=cpu avoids that
ULA_CHAT_ARGS="--cache-ram 0"      # no room for a host-RAM prompt cache; a subagent call re-prefills the main conversation
ULA_TTL=600                 # unload after 10 min idle to give the RAM back
ULA_MIN_DISK_GIB=5
