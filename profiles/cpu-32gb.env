# x86/ARM machine with ~32 GB RAM and no usable GPU (pure CPU, or an iGPU left unused).
# Only MoE models with few active params are usable on CPU: Qwen3.6-35B-A3B reads ~2 GB of weights per token at Q4.
# Dense Qwen3.8-27B would decode at a few tok/s and prefill for minutes, and gpt-oss-20b next to the coder does
# not fit (~39 GiB), so there is no separate architect model. coder and architect name the same file and context:
# ula runs them as one process, and plan/build switches or reviewer subagents keep the KV and prompt cache
# (a swap on CPU would mean a reload plus a full re-prefill, minutes at 30-60K tokens).
# Budget (MemTotal ~31 GiB):
#   Qwen3.6-35B-A3B heretic i1-Q4_K_M 19.7 GiB resident (its 0.5 GiB MTP layer is skipped at load)
#   + KV 64K 1.25 GiB (20 KiB/token) + DeltaNet checkpoints <=0.5 + ~1.5 compute + 1.5 prompt cache = ~24.5 GiB
#   embed + rerank at 4K ~2.7 GiB          total ~27.1 GiB, ~3.9 GiB left for the OS and OpenCode
# The 1.5 GiB prompt cache holds one full 64K conversation state (~1.3 GiB), so returning from a subagent
# call does not re-prefill the main conversation.
# The stock UD-Q4_K_M is 0.9 GiB bigger (~28 GiB total); it never runs next to the uncensored coder.
# Not benchmarked on CPU yet. Context costs prefill time here, not memory.
PROFILE_DESC="CPU only, ~32 GB RAM"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-q4km@65536
architect=qwen3.6-35b-a3b-heretic-q4km@65536
coder-stock=qwen3.6-35b-a3b-q4km@65536
architect-stock=qwen3.6-35b-a3b-q4km@65536
embed=qwen3-embedding-0.6b-q8@4096
rerank=qwen3-reranker-0.6b-q8@4096
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=true          # coder and architect are one process; true keeps uncensored and stock from loading together
ULA_GPU_ARGS=""             # CPU. A Vulkan/ROCm build still offloads to an iGPU by default (-ngl auto); ULA_ACCEL=cpu avoids that
ULA_CHAT_ARGS="--cache-ram 1536"   # host-RAM prompt cache cap: one full 64K state (default 8 GiB is too much here)
ULA_TTL=1800                # unload after 30 min idle
ULA_MIN_DISK_GIB=8
