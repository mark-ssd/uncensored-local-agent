# Single NVIDIA GPU with 16 GB VRAM (RTX 4060 Ti 16G, 4070 Ti Super, 4080, 5060 Ti 16G, 5070 Ti, 5080), >= 32 GB system RAM.
# GPU budgets = GPU-resident weights (token_embd stays in RAM, the MTP layer is not loaded) + KV + DeltaNet state
#   + ~1.5 GiB compute buffer (assumed) + ~0.4 GiB CUDA context. Estimates, not measured.
# coder: Qwen3.6-35B-A3B heretic i1-Q4_K_M, experts of the first 20 of 40 layers in system RAM (--n-cpu-moe):
#   10.4 GiB weights + 1.25 GiB KV (64K, f16) + ~2.0 GiB = ~13.6 GiB on the GPU, ~9.1 GiB of experts in RAM.
# architect: dense Qwen3.8-27B heretic-ara i1-IQ3_M fully on the GPU: 11.2 GiB + 1.1 GiB q8 KV (32K) + ~2.0 GiB = ~14.3 GiB.
# Only one chat model fits at a time: llama-swap swaps "coder" and "architect" on demand.
# embed/rerank run on the CPU with --device none (-ngl 0 alone still opens a CUDA context and offloads prompt batches).
# Headless box: --n-cpu-moe 18 is faster (+0.9 GiB). If a desktop shares the GPU and the architect fails to load, drop it to 24576.
PROFILE_DESC="Single NVIDIA GPU, 16 GB VRAM (+ >= 32 GB RAM)"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-q4km@65536@--n-cpu-moe 20
architect=qwen3.8-27b-heretic-ara-iq3m@32768@-ctk q8_0 -ctv q8_0
coder-stock=qwen3.6-35b-a3b-q4km@65536@--n-cpu-moe 22
architect-stock=qwen3.8-27b-iq3s@32768@-ctk q8_0 -ctv q8_0
embed=qwen3-embedding-0.6b-q8@8192@-ngl 0 --device none
rerank=qwen3-reranker-0.6b-q8@8192@-ngl 0 --device none
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=true          # true: one chat model resident at a time
ULA_GPU_ARGS="-ngl 999"
ULA_CHAT_ARGS="--cache-ram 4096"   # host-RAM prompt cache cap; RAM also holds ~9 GiB of coder experts
ULA_TTL=900                 # unload an idle chat model after 15 min to give VRAM back
ULA_MIN_DISK_GIB=10
