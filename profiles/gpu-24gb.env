# Single NVIDIA GPU with 24 GB VRAM (RTX 3090, 3090 Ti, 4090), >= 32 GB system RAM.
# GPU budgets = GPU-resident weights (token_embd stays in RAM, the MTP layer is not loaded) + KV + DeltaNet state
#   + ~1.5 GiB compute buffer (assumed) + ~0.4 GiB CUDA context. Estimates, not measured.
# coder: Qwen3.6-35B-A3B heretic i1-IQ4_XS fully on the GPU: 17.2 GiB + 2.5 GiB KV (128K, f16) + ~2.0 GiB = ~21.7 GiB.
# architect: dense Qwen3.8-27B heretic-ara i1-Q4_K_M: 14.7 GiB + 2.1 GiB q8 KV (64K) + ~2.0 GiB = ~18.9 GiB.
# Only one chat model fits at a time: llama-swap swaps "coder" and "architect" on demand.
# embed/rerank run on the CPU with --device none (-ngl 0 alone still opens a CUDA context and offloads prompt batches).
PROFILE_DESC="Single NVIDIA GPU, 24 GB VRAM (3090 / 4090)"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-iq4xs@131072
architect=qwen3.8-27b-heretic-ara-q4km@65536@-ctk q8_0 -ctv q8_0
coder-stock=qwen3.6-35b-a3b-iq4xs@131072
architect-stock=qwen3.8-27b-q4km@65536@-ctk q8_0 -ctv q8_0
embed=qwen3-embedding-0.6b-q8@8192@-ngl 0 --device none
rerank=qwen3-reranker-0.6b-q8@8192@-ngl 0 --device none
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=true          # true: one chat model resident at a time
ULA_GPU_ARGS="-ngl 999"
ULA_CHAT_ARGS="--cache-ram 4096"   # host-RAM prompt cache cap
ULA_TTL=900                 # unload an idle chat model after 15 min to give VRAM back
ULA_MIN_DISK_GIB=10
