# NVIDIA GPU with 48 GB VRAM (RTX A6000, RTX 6000 Ada, L40S, A40) or two 24 GB cards (pick with --profile gpu-48gb;
# auto-detection sizes by the largest single GPU). >= 32 GB system RAM.
# GPU budgets = GPU-resident weights (token_embd stays in RAM, the MTP layer is not loaded) + KV + DeltaNet state
#   + ~1.5 GiB compute buffer (assumed) + ~0.4 GiB CUDA context per process. Estimates, not measured.
# Both chat models stay resident, no swapping:
#   coder: Qwen3.6-35B-A3B heretic i1-Q4_K_M 19.4 GiB + 2.5 GiB KV (128K, f16) + ~2.0 GiB = ~23.9 GiB
#   architect: dense Qwen3.8-27B heretic-ara i1-Q4_K_M 14.7 GiB + 2.1 GiB q8 KV (64K) + ~2.0 GiB = ~18.9 GiB
#   total ~42.8 GiB (stock pair ~43.4 GiB). L40S / A40 / ECC-on A6000 report 45.0 GiB usable: ~2 GiB headroom, keep the
#   desktop off that GPU. embed/rerank run on the CPU with --device none.
# Never run three chat models at once: an uncensored and a stock model of the same role together do not fit.
PROFILE_DESC="NVIDIA GPU, 48 GB VRAM (A6000 / 6000 Ada / L40S / 2x24 GB)"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-q4km@131072
architect=qwen3.8-27b-heretic-ara-q4km@65536@-ctk q8_0 -ctv q8_0
coder-stock=qwen3.6-35b-a3b-q4km@131072
architect-stock=qwen3.8-27b-q4km@65536@-ctk q8_0 -ctv q8_0
embed=qwen3-embedding-0.6b-q8@8192@-ngl 0 --device none
rerank=qwen3-reranker-0.6b-q8@8192@-ngl 0 --device none
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=false         # coder and architect fit side by side
ULA_GPU_ARGS="-ngl 999"
ULA_CHAT_ARGS="--cache-ram 4096"   # per server process; two run at once
ULA_TTL=1800                # unload an idle chat model after 30 min
ULA_MIN_DISK_GIB=12
