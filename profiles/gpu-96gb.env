# NVIDIA GPU with 96 GB VRAM (RTX PRO 6000 Blackwell, H100 NVL 94 GB, GH200 96 GB), >= 32 GB system RAM.
# GPU budgets = GPU-resident weights (token_embd stays in RAM) + KV + DeltaNet state
#   + ~1.5 GiB compute buffer (assumed) + ~0.4 GiB CUDA context per process. Estimates, not measured.
# Both chat models in Q8_0 stay resident, no swapping:
#   coder: Qwen3.6-35B-A3B heretic Q8_0 33.9 GiB + 5.0 GiB KV (256K, f16) + ~2.0 GiB = ~40.9 GiB
#   architect: dense Qwen3.8-27B heretic-ara Q8_0 25.4 GiB + 8.0 GiB KV (128K, f16) + ~2.0 GiB = ~35.4 GiB
#   embed + rerank on the GPU ~4.4 GiB; total ~81 GiB of 95.6.
# Needs ~81 GiB: not for 80 GB A100/H100 cards (use gpu-48gb there).
PROFILE_DESC="NVIDIA GPU, 96 GB VRAM (RTX PRO 6000)"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-q8@262144
architect=qwen3.8-27b-heretic-ara-q8@131072
coder-stock=qwen3.6-35b-a3b-q8@262144
architect-stock=qwen3.8-27b-q8@131072
embed=qwen3-embedding-0.6b-q8@8192
rerank=qwen3-reranker-0.6b-q8@8192
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=false         # coder and architect fit side by side
ULA_GPU_ARGS="-ngl 999"
ULA_CHAT_ARGS="--cache-ram 8192"   # per server process; two run at once
ULA_TTL=1800                # unload an idle chat model after 30 min
ULA_MIN_DISK_GIB=16
