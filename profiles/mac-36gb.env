# Apple Silicon with 36-48 GB unified memory (MacBook Pro M3/M4 Max 36 GB, M4 Pro 48 GB; auto-picked for 34-59 GiB).
# Budgeted against ~24 GiB of Metal working set (2/3 of 36 GB). The measured 24 GB M4 Pro gets 74%, so a real 36 GB
# Mac probably allows ~26 GiB and a 48 GB one ~36 GiB. Check recommendedMaxWorkingSetSize in `ula logs`
# (printed in MB of 10^6 bytes: 24 GiB = 25770 MB).
#   coder     Qwen3.6-35B-A3B heretic i1-Q4_K_M 20.2 GiB + KV 64K 1.25 GiB (f16) + ~1.5 compute = ~23.0 GiB
#   architect Qwen3.8-27B heretic-ara i1-Q4_K_M 15.7 GiB + KV 64K 2.1 GiB (q8_0) + ~1.5 compute = ~19.3 GiB
#   stock:    Qwen3.6 UD-Q4_K_M 20.6 GiB -> ~23.4 GiB; Qwen3.8 UD-Q4_K_M 15.3 GiB -> ~19.0 GiB
# The pair (~42 GiB) does not fit, so llama-swap swaps "coder" and "architect" on demand. embed/rerank run on CPU beside them.
# If the coder fails to load on a 36 GB Mac with a busy desktop, drop it to 49152.
PROFILE_DESC="Apple Silicon, 36-48 GB unified memory"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-q4km@65536
architect=qwen3.8-27b-heretic-ara-q4km@65536@-ctk q8_0 -ctv q8_0
coder-stock=qwen3.6-35b-a3b-q4km@65536
architect-stock=qwen3.8-27b-q4km@65536@-ctk q8_0 -ctv q8_0
embed=qwen3-embedding-0.6b-q8@8192@-ngl 0
rerank=qwen3-reranker-0.6b-q8@8192@-ngl 0
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=true          # true: one chat model resident at a time
ULA_GPU_ARGS="-ngl 999"
ULA_CHAT_ARGS="--cache-ram 2048"   # host-RAM prompt cache cap (default 8 GiB is too much here)
ULA_TTL=900                 # unload an idle chat model after 15 min to give RAM back
ULA_MIN_DISK_GIB=10
