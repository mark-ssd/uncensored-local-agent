# Apple Silicon with 64-96 GB unified memory (Mac mini / MacBook Pro M4/M5 Pro 64 GB, Mac Studio 64/96 GB).
# Metal working set ~48 GiB (75%; a 64 GB M1/M2 Max reports 49152 MiB = 48 GiB). Both chat models stay resident (no swaps):
#   coder     Qwen3.6-35B-A3B heretic i1-Q5_K_M 23.6 GiB + KV 64K 1.25 GiB (f16) + ~1.5 compute = ~26.4 GiB
#   architect Qwen3.8-27B heretic-ara i1-Q4_K_M 15.7 GiB + KV 64K 2.1 GiB (q8_0) + ~1.5 compute = ~19.3 GiB
#   together ~45.7 GiB of ~48. Host RAM adds 2 x 2 GiB prompt cache and ~1.5 GiB for embed/rerank on CPU.
# Q5 goes to the coder because the 3B-active MoE is the more quant-sensitive model. The dense 27B architect at Q4_K_M
# is reported on par with BF16 on TB2.1. A Q5_K_M/Q6_K architect (+2.5/+5.2 GiB) does not fit beside it at 48 GiB.
# On a 96 GB Mac (~72 GiB Metal) there is room for it.
# Stock models sit in their own exclusive group: they load one at a time and unload the uncensored pair first.
#   Qwen3.6 UD-Q5_K_M 24.6 GiB -> ~27.4 GiB, Qwen3.8 UD-Q4_K_M 15.3 GiB -> ~19.0 GiB.
PROFILE_DESC="Apple Silicon, 64-96 GB unified memory (coder + architect resident)"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-q5km@65536
architect=qwen3.8-27b-heretic-ara-q4km@65536@-ctk q8_0 -ctv q8_0
coder-stock=qwen3.6-35b-a3b-q5km@65536
architect-stock=qwen3.8-27b-q4km@65536@-ctk q8_0 -ctv q8_0
embed=qwen3-embedding-0.6b-q8@8192@-ngl 0
rerank=qwen3-reranker-0.6b-q8@8192@-ngl 0
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=false         # false: coder and architect resident together
ULA_GPU_ARGS="-ngl 999"
ULA_CHAT_ARGS="--cache-ram 2048"   # per chat process; two of them run here
ULA_TTL=1800                # unload an idle chat model after 30 min
ULA_MIN_DISK_GIB=10
