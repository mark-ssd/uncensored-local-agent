# 128 GB unified-memory machine with no discrete GPU: AMD Strix Halo (Ryzen AI Max+ 395; ROCm or Vulkan) or
# NVIDIA DGX Spark / GB10 (CUDA). Auto-picked at >=110 GiB MemTotal when no >=14 GiB discrete NVIDIA card is found
# (GB10 reports memory.total as [N/A], which ula reads as 0). All layers on the GPU, one memory pool.
# A plain 128 GB desktop or server without such an APU also lands here: set ULA_ACCEL=cpu (-ngl is then ignored).
# Budget (~119 GiB visible on a Spark), both chat models resident at once; weights counted at full file size
# (the coder's 0.65 GiB MTP layer is actually skipped at load, so that is a small extra margin):
#   architect gpt-oss-120b Derestricted MXFP4 59.0 GiB + KV 128K 4.5 (36 KiB/token) + SWA checkpoints ~0.4
#             + ~1.5 compute + ~0.4 GPU context + 2 prompt cache = ~67.8 GiB
#   coder     Qwen3.6-35B-A3B heretic i1-Q6_K 27.2 GiB + KV 128K 2.5 + DeltaNet checkpoints <=1.0 + ~1.5 compute
#             + ~0.4 GPU context + 2 prompt cache = ~34.6 GiB
#   embed + rerank at 8K on the GPU ~4.3 GiB          total ~106.8 GiB, ~12 GiB left for the OS and OpenCode
# Q8_0 coder would total ~114 GiB (~5 GiB left): possible, but Q6_K is near-lossless and decodes faster.
# Strix Halo on Linux: keep the BIOS UMA/VRAM carve-out small and raise the GPU-mappable limit to ~110 GiB
# (ttm.pages_limit / amdgpu.gttsize kernel params), or -ngl 999 fails to allocate. A large BIOS carve-out also
# lowers MemTotal, and auto-detect then picks a cpu-* profile: set ULA_PROFILE=unified-128gb.
# If the ROCm build fails on gfx1151, set ULA_ACCEL=vulkan. If model loads are slow, try "--load-mode none".
# architect runs gpt-oss at --reasoning-effort high: slow (minutes for hard questions) but it is the planner.
# gpt-oss caveats: "architect:fast" only lowers reasoning_effort to low (harmony has no thinking-off switch),
# and its template silently drops a system message that is not the first one.
# Stock aliases go to a separate exclusive group: loading one unloads the uncensored pair first.
PROFILE_DESC="Unified memory 128 GB (Strix Halo, DGX Spark)"

# alias=catalog_id@ctx[@extra llama-server args]
# Aliases are stable API model names; harness configs only ever reference aliases.
ULA_MODELS="
coder=qwen3.6-35b-a3b-heretic-q6k@131072
architect=gpt-oss-120b-derestricted-mxfp4@131072@--reasoning-effort high
coder-stock=qwen3.6-35b-a3b-q6k@131072
architect-stock=gpt-oss-120b-mxfp4@131072@--reasoning-effort high
embed=qwen3-embedding-0.6b-q8@8192
rerank=qwen3-reranker-0.6b-q8@8192
"
# Installed by default; the rest with `ula pull --all` or `install.sh --all-models`.
ULA_DEFAULT="coder architect embed rerank"

ULA_CODER=coder
ULA_ARCHITECT=architect
ULA_SWAP_LLMS=false         # coder and architect fit side by side
ULA_GPU_ARGS="-ngl 999"
ULA_CHAT_ARGS="--cache-ram 2048"   # per server process; two run at once
ULA_TTL=3600                # reloading ~60 GB is slow; keep models warm for an hour
ULA_MIN_DISK_GIB=16
